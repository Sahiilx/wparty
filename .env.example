# PartyKit Server Host Configuration
# Local Development:
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Vercel Production Deployment:
# Deploy your PartyKit server via: npm run party:deploy
# Then paste your deployed domain below (or set it in Vercel Project Settings > Environment Variables):
# NEXT_PUBLIC_PARTYKIT_HOST=party-platform.<your-partykit-username>.partykit.dev

